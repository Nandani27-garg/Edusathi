<%- include('partials/header', { pageTitle: (lang === 'hi') ? 'मेरी पढ़ाई - पाठ्यक्रम' : 'My Learning - Courses' }) %>
<%- include('partials/navbar', { activeTab: 'learn' }) %>

<div class="app-layout">
  <%- include('partials/sidebar', { activeTab: 'learn' }) %>

  <main class="app-content">
    <!-- LMS Header -->
    <div class="lms-header-box">
      <div class="lms-header-info">
        <h1 class="lms-title"><%= (lang === 'hi') ? 'मेरी पढ़ाई' : 'My Learning' %></h1>
        <p class="lms-subtitle">
          <%= (lang === 'hi') 
            ? 'अवधारणाओं की स्पष्ट समझ और परीक्षा की तैयारी के लिए संरचित पाठ्यक्रम।' 
            : 'Structured curriculum designed for conceptual clarity and continuous progress.' %>
        </p>
      </div>

      <!-- Search Bar -->
      <div class="lms-search-wrap">
        <span class="lms-search-icon">🔍</span>
        <input 
          type="text" 
          id="course-search-input" 
          class="lms-search-input" 
          placeholder="<%= (lang === 'hi') ? 'विषय या पाठ खोजें...' : 'Search subjects, topics, lessons...' %>"
          aria-label="Search courses"
        >
      </div>
    </div>

    <!-- Filter Pills Bar -->
    <div class="lms-filters-bar">
      <div class="lms-status-filters" id="lms-status-filters">
        <button type="button" class="lms-filter-btn active" data-filter="all"><%= (lang === 'hi') ? 'सभी' : 'All' %></button>
        <button type="button" class="lms-filter-btn" data-filter="my-courses"><%= (lang === 'hi') ? 'मेरे कोर्स' : 'My Courses' %></button>
        <button type="button" class="lms-filter-btn" data-filter="recommended"><%= (lang === 'hi') ? 'अनुशंसित' : 'Recommended' %></button>
        <button type="button" class="lms-filter-btn" data-filter="completed"><%= (lang === 'hi') ? 'पूर्ण' : 'Completed' %></button>
      </div>

      <div class="lms-subject-pills">
        <% categories.forEach(cat => { %>
          <a href="/learn<%= cat !== 'All' ? '?category=' + encodeURIComponent(cat) : '' %>" 
             class="lms-pill-tag <%= (selectedCategory === cat) ? 'active' : '' %>">
            <%= (lang === 'hi' && cat === 'All') ? 'सभी विषय' : cat %>
          </a>
        <% }); %>
      </div>
    </div>

    <!-- Offline disclaimer pill -->
    <div class="lms-offline-badge-bar">
      <span>📶</span>
      <span><%= (lang === 'hi') ? 'चयनित पाठ ऑफ़लाइन उपलब्ध: बिना नेटवर्क के भी पढ़ाई जारी रखें।' : 'Selected Lessons Available Offline: Download lessons and learn even when disconnected.' %></span>
    </div>

    <!-- Courses Grid (LMS style compact cards) -->
    <div class="lms-courses-grid" id="lms-courses-grid">
      <% courses.forEach((course, idx) => { %>
        <% 
          const isCompleted = course.progressPct >= 100;
          const isStarted = course.progressPct > 0;
          const isRecommended = idx === 0 || course.category === 'Science';
        %>
        <article 
          class="lms-course-card" 
          data-category="<%= course.category.toLowerCase() %>"
          data-started="<%= isStarted %>"
          data-completed="<%= isCompleted %>"
          data-recommended="<%= isRecommended %>"
        >
          <!-- Card Header: Subject Tag & Offline Badge -->
          <div class="lms-card-top">
            <span class="lms-subject-badge" style="background-color: <%= course.color %>15; color: <%= course.color %>; border: 1px solid <%= course.color %>30;">
              <%= course.category %>
            </span>
            <span class="lms-offline-badge" title="Selected lessons cached offline">
              ✓ <%= (lang === 'hi') ? 'ऑफ़लाइन समर्थित' : 'Offline Ready' %>
            </span>
          </div>

          <!-- Course Title -->
          <h2 class="lms-course-title">
            <%= (lang === 'hi') ? course.title_hi : course.title %>
          </h2>

          <p class="lms-course-desc">
            <%= (lang === 'hi') ? course.description_hi : course.description %>
          </p>

          <!-- Progress Block -->
          <div class="lms-progress-block">
            <div class="lms-progress-labels">
              <span><%= course.completed_lessons %> / <%= course.total_lessons %> <%= (lang === 'hi') ? 'पाठ पूर्ण' : 'lessons' %></span>
              <strong><%= course.progressPct %>%</strong>
            </div>
            <div class="progress-bar-bg">
              <div class="progress-bar-fill" style="width: <%= course.progressPct %>%; background-color: <%= course.color %>;"></div>
            </div>
          </div>

          <!-- Card Footer Action -->
          <div class="lms-card-footer">
            <span class="lms-lesson-count">
              📖 <%= course.total_lessons %> <%= (lang === 'hi') ? 'पाठ' : 'Lessons' %>
            </span>
            <a href="/learn/<%= course.slug %>" class="btn btn-sm btn-primary">
              <span><%= (lang === 'hi') ? 'पढ़ना जारी रखें' : 'Continue' %></span>
              <span>→</span>
            </a>
          </div>
        </article>
      <% }); %>
    </div>
  </main>
</div>

<script>
  // Client-side instant course search and filtering
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('course-search-input');
    const filterButtons = document.querySelectorAll('.lms-filter-btn');
    const cards = document.querySelectorAll('.lms-course-card');

    function applyFilters() {
      const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
      const activeBtn = document.querySelector('.lms-filter-btn.active');
      const activeFilter = activeBtn ? activeBtn.dataset.filter : 'all';

      cards.forEach(card => {
        const text = card.innerText.toLowerCase();
        const matchesQuery = !query || text.includes(query);
        let matchesFilter = true;

        if (activeFilter === 'my-courses') {
          matchesFilter = card.dataset.started === 'true';
        } else if (activeFilter === 'recommended') {
          matchesFilter = card.dataset.recommended === 'true';
        } else if (activeFilter === 'completed') {
          matchesFilter = card.dataset.completed === 'true';
        }

        if (matchesQuery && matchesFilter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters);
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilters();
      });
    });
  });
</script>

<%- include('partials/bottom-nav', { activeTab: 'learn' }) %>
<%- include('partials/footer') %>
