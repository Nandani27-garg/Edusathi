<%- include('partials/header', { pageTitle: (lang === 'hi') ? 'करियर मार्गदर्शन - EduSaarthi' : 'Career Guidance' }) %>
<%- include('partials/navbar', { activeTab: 'career' }) %>

<div class="app-layout">
  <%- include('partials/sidebar', { activeTab: 'career' }) %>

  <main class="app-content">
    <!-- Header -->
    <div class="lms-header-box">
      <div class="lms-header-info">
        <h1 class="lms-title"><%= (lang === 'hi') ? 'करियर मार्गदर्शन' : 'Career Guidance' %></h1>
        <p class="lms-subtitle">
          <%= (lang === 'hi') 
            ? 'अपना भविष्य और करियर मार्ग चुनें — अपनी रुचियों, कक्षा और प्राथमिकताओं के आधार पर सही विकल्प खोजें।' 
            : 'Discover Your Career Path — Personalized career pathways, prerequisite skills, and step-by-step milestones.' %>
        </p>
      </div>

      <span class="badge badge-primary">🎯 <%= (lang === 'hi') ? 'मार्गदर्शन' : 'Advisory Guidance' %></span>
    </div>

    <!-- Guidance Disclaimer Pill -->
    <div class="demo-disclaimer-pill" style="margin-bottom: 1.5rem;">
      <span style="font-size: 1rem;">ℹ️</span>
      <span><strong><%= (lang === 'hi') ? 'सलाह:' : 'Note:' %></strong> <%= (lang === 'hi') ? 'यह करियर मार्गदर्शन विद्यार्थियों के लिए सांकेतिक योजना है। अंतिम निर्णय से पूर्व अपने शिक्षकों व मेंटर्स से भी परामर्श लें।' : 'This roadmap is an educational guidance advisory. Verify academic requirements with mentors.' %></span>
    </div>

    <!-- 2-Column or Single Column Grid -->
    <div style="display: grid; grid-template-columns: <%= careerAdvice ? '380px 1fr' : 'minmax(320px, 600px)' %>; gap: 2rem; align-items: flex-start;">
      <!-- Questionnaire Card -->
      <div class="card" style="padding: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
          <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--text-main);">
            <%= (lang === 'hi') ? 'विद्यार्थी प्रश्नावली' : 'Student Questionnaire' %>
          </h3>
          <button type="button" id="fill-demo-career" class="btn btn-sm btn-accent" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
            ⚡ Demo Tech
          </button>
        </div>

        <form id="career-form" action="/career/advice" method="POST">
          <!-- Education Level -->
          <div class="form-group">
            <label for="education_level" class="form-label"><%= (lang === 'hi') ? 'वर्तमान कक्षा' : 'Current Education Level' %></label>
            <select id="education_level" name="education_level" class="form-select">
              <option value="Class 10" selected>Class 10</option>
              <option value="Class 9">Class 9</option>
              <option value="Class 11">Class 11</option>
              <option value="Class 12">Class 12</option>
              <option value="Polytechnic">Polytechnic / ITI</option>
              <option value="College">College / Degree</option>
            </select>
          </div>

          <!-- Favorite Subjects -->
          <div class="form-group">
            <label for="subjects" class="form-label"><%= (lang === 'hi') ? 'पसंदीदा विषय' : 'Favorite Subjects' %></label>
            <input type="text" id="subjects" name="subjects" class="form-control" placeholder="e.g. Science, Mathematics, English" value="<%= (formData && formData.subjects) ? formData.subjects : 'Science, Mathematics' %>">
          </div>

          <!-- Field of Interest -->
          <div class="form-group">
            <label for="interest" class="form-label"><%= (lang === 'hi') ? 'रुचि का क्षेत्र' : 'Primary Field of Interest' %></label>
            <select id="interest" name="interest" class="form-select">
              <option value="Technology" selected>💻 Technology & Computers (डेटा, सॉफ्टवेयर)</option>
              <option value="Healthcare">🏥 Healthcare & Medicine (चिकित्सा, नर्सिंग)</option>
              <option value="Government Services">🏛️ Government Services (प्रशासनिक सेवाएं)</option>
              <option value="Environment">🌱 Agriculture & Environment (कृषि, पर्यावरण)</option>
              <option value="Teaching">📚 Teaching & Education (शिक्षण)</option>
              <option value="Business">💼 Commerce & Entrepreneurship (व्यवसाय)</option>
            </select>
          </div>

          <!-- Strengths -->
          <div class="form-group">
            <label for="skills" class="form-label"><%= (lang === 'hi') ? 'आपकी ताकत या कौशल' : 'Your Strengths' %></label>
            <input type="text" id="skills" name="skills" class="form-control" placeholder="e.g. Logic, problem solving, curiosity" value="<%= (formData && formData.skills) ? formData.skills : 'Problem solving, curiosity' %>">
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1.25rem;">
            <span>🧭</span>
            <span><%= (lang === 'hi') ? 'करियर रोडमैप देखें' : 'Generate Career Roadmap' %></span>
          </button>
        </form>
      </div>

      <!-- Result Card: Career Path, Skills, Roadmap -->
      <% if (careerAdvice) { %>
        <div class="card" style="border-top: 4px solid var(--primary); padding: 1.75rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span class="badge badge-primary"><%= (lang === 'hi') ? 'अनुशंसित करियर मार्ग' : 'Possible Career Path' %></span>
            <span class="badge badge-success">✓ <%= (lang === 'hi') ? 'मार्गदर्शन उपलब्ध' : 'Roadmap Ready' %></span>
          </div>

          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--primary); margin-bottom: 0.75rem;">
            <%= (lang === 'hi' && careerAdvice.title_hi) ? careerAdvice.title_hi : careerAdvice.title %>
          </h2>

          <!-- Why This Fits -->
          <div style="background: #EFF6FF; border-radius: var(--radius-md); padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
            <h4 style="font-size: 0.95rem; font-weight: 700; color: #1E40AF; margin-bottom: 0.4rem;">
              <%= (lang === 'hi') ? 'यह करियर क्यों उपयुक्त है:' : 'Why It Fits You:' %>
            </h4>
            <ul style="padding-left: 1.25rem; margin: 0; font-size: 0.88rem; color: #1E3A8A; display: flex; flex-direction: column; gap: 0.25rem;">
              <% 
                const fits = (lang === 'hi' && careerAdvice.whyFit_hi) ? careerAdvice.whyFit_hi : (careerAdvice.whyFit || []);
                fits.forEach(fit => { 
              %>
                <li><%= fit %></li>
              <% }); %>
            </ul>
          </div>

          <!-- Skills to Develop -->
          <div style="margin-bottom: 1.75rem;">
            <h4 style="font-size: 1rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.6rem;">
              <%= (lang === 'hi') ? 'सीखने योग्य आवश्यक कौशल (Skills to Develop):' : 'Skills to Develop:' %>
            </h4>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
              <% 
                const defaultSkills = ['SQL', 'Excel', 'Python', 'Statistics & Logic'];
                const skillList = (careerAdvice.skills && careerAdvice.skills.length > 0) ? careerAdvice.skills : defaultSkills;
                skillList.forEach(sk => { 
              %>
                <span class="badge badge-slate" style="font-size: 0.85rem; padding: 0.35rem 0.75rem;">
                  ⚡ <%= sk %>
                </span>
              <% }); %>
            </div>
          </div>

          <!-- Learning Roadmap: Learn → Practice → Build Projects → Internship -->
          <div style="margin-bottom: 1.5rem;">
            <h4 style="font-size: 1rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.85rem;">
              <%= (lang === 'hi') ? 'सीखने का रोडमैप (Learning Roadmap):' : 'Learning Roadmap:' %>
            </h4>

            <div class="career-milestone-flow">
              <div class="milestone-step">
                <div class="milestone-badge">1</div>
                <div class="milestone-info">
                  <strong><%= (lang === 'hi') ? 'सीखें (Learn)' : 'Learn' %></strong>
                  <span><%= (lang === 'hi') ? 'मूल अवधारणाओं व सिद्धांतों को समझें' : 'Master foundation concepts' %></span>
                </div>
              </div>
              <div class="milestone-arrow">➔</div>

              <div class="milestone-step">
                <div class="milestone-badge">2</div>
                <div class="milestone-info">
                  <strong><%= (lang === 'hi') ? 'अभ्यास (Practice)' : 'Practice' %></strong>
                  <span><%= (lang === 'hi') ? 'क्विज़ व दैनिक प्रश्नों का हल करें' : 'Daily questions & drills' %></span>
                </div>
              </div>
              <div class="milestone-arrow">➔</div>

              <div class="milestone-step">
                <div class="milestone-badge">3</div>
                <div class="milestone-info">
                  <strong><%= (lang === 'hi') ? 'प्रोजेक्ट्स बनाएं' : 'Build Projects' %></strong>
                  <span><%= (lang === 'hi') ? 'छोटे व्यावहारिक मॉडल तैयार करें' : 'Real practical exercises' %></span>
                </div>
              </div>
              <div class="milestone-arrow">➔</div>

              <div class="milestone-step">
                <div class="milestone-badge">4</div>
                <div class="milestone-info">
                  <strong><%= (lang === 'hi') ? 'इंटर्नशिप / करियर' : 'Internship' %></strong>
                  <span><%= (lang === 'hi') ? 'व्यावसायिक अनुभव प्राप्त करें' : 'Livelihood & mentorship' %></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script>
  const demoBtn = document.getElementById('fill-demo-career');
  if (demoBtn) {
    demoBtn.addEventListener('click', () => {
      document.getElementById('education_level').value = 'Class 10';
      document.getElementById('subjects').value = 'Mathematics, Computer Science, Physics';
      document.getElementById('interest').value = 'Technology';
      document.getElementById('skills').value = 'Logical reasoning, Python curiosity';
      if (window.showToast) {
        window.showToast('Demo Tech profile loaded (Class 10, Data & Tech)', 'info');
      }
      setTimeout(() => {
        document.getElementById('career-form').submit();
      }, 350);
    });
  }
</script>

<%- include('partials/bottom-nav', { activeTab: 'career' }) %>
<%- include('partials/footer') %>
