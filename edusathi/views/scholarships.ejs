<%- include('partials/header', { pageTitle: (lang === 'hi') ? 'छात्रवृत्ति खोज - EduSaarthi' : 'Find Scholarships' }) %>
<%- include('partials/navbar', { activeTab: 'scholarships' }) %>

<div class="app-layout">
  <%- include('partials/sidebar', { activeTab: 'scholarships' }) %>

  <main class="app-content">
    <!-- Header -->
    <div class="lms-header-box">
      <div class="lms-header-info">
        <h1 class="lms-title"><%= (lang === 'hi') ? 'अपने लिए छात्रवृत्तियां खोजें' : 'Find scholarships for you' %></h1>
        <p class="lms-subtitle">
          <%= (lang === 'hi') 
            ? 'अपनी पृष्ठभूमि, श्रेणी और राज्य के अनुसार सरकारी वित्तीय सहायता योजनाएं खोजें।' 
            : 'Discover government financial aid and scholarship schemes matched to your academic profile.' %>
        </p>
      </div>

      <button type="button" id="fill-demo-profile" class="btn btn-sm btn-accent" title="Autofill Demo Profile">
        ⚡ <%= (lang === 'hi') ? 'डेमो प्रोफ़ाइल भरें' : 'Demo Profile' %>
      </button>
    </div>

    <!-- Required Hackathon Disclaimer -->
    <div class="demo-disclaimer-pill" style="margin-bottom: 1.5rem;">
      <span style="font-size: 1rem;">ℹ️</span>
      <span><strong><%= (lang === 'hi') ? 'सूचना:' : 'Notice:' %></strong> Prototype scholarship data — <%= (lang === 'hi') ? 'प्रोटोटाइप/डेमो डेटा — आधिकारिक छात्रवृत्ति प्रदाता से विवरण सत्यापित करें।' : 'verify details with the official scholarship provider before applying.' %></span>
    </div>

    <!-- Filters + Results Grid Layout -->
    <div class="scholarship-layout-grid">
      <!-- Filter Card -->
      <aside class="card scholarship-filter-card">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--text-main); margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
          <%= (lang === 'hi') ? 'पात्रता फ़िल्टर' : 'Filter by Eligibility' %>
        </h3>

        <form id="scholarship-filter-form" action="/scholarships" method="GET">
          <!-- State -->
          <div class="form-group">
            <label for="state" class="form-label"><%= (lang === 'hi') ? 'राज्य' : 'State' %></label>
            <select id="state" name="state" class="form-select">
              <option value="All" <%= filters.state === 'All' ? 'selected' : '' %>>All India (National)</option>
              <option value="Jharkhand" <%= filters.state === 'Jharkhand' ? 'selected' : '' %>>Jharkhand</option>
              <option value="Bihar" <%= filters.state === 'Bihar' ? 'selected' : '' %>>Bihar</option>
              <option value="Odisha" <%= filters.state === 'Odisha' ? 'selected' : '' %>>Odisha</option>
              <option value="Madhya Pradesh" <%= filters.state === 'Madhya Pradesh' ? 'selected' : '' %>>Madhya Pradesh</option>
            </select>
          </div>

          <!-- Course / Education Level -->
          <div class="form-group">
            <label for="education_level" class="form-label"><%= (lang === 'hi') ? 'कक्षा / कोर्स' : 'Course / Education' %></label>
            <select id="education_level" name="education_level" class="form-select">
              <option value="All" <%= filters.education_level === 'All' ? 'selected' : '' %>>All Levels</option>
              <option value="Class 9-10" <%= filters.education_level === 'Class 9-10' ? 'selected' : '' %>>Class 9-10 (Pre-Matric)</option>
              <option value="Class 11-12 & Higher" <%= filters.education_level === 'Class 11-12 & Higher' ? 'selected' : '' %>>Class 11-12 & Higher</option>
              <option value="Polytechnic / Diploma / B.Tech" <%= filters.education_level === 'Polytechnic / Diploma / B.Tech' ? 'selected' : '' %>>Polytechnic / Diploma</option>
            </select>
          </div>

          <!-- Category -->
          <div class="form-group">
            <label for="category" class="form-label"><%= (lang === 'hi') ? 'श्रेणी' : 'Category' %></label>
            <select id="category" name="category" class="form-select">
              <option value="All" <%= filters.category === 'All' ? 'selected' : '' %>>All Categories</option>
              <option value="ST" <%= filters.category === 'ST' ? 'selected' : '' %>>Scheduled Tribe (ST)</option>
              <option value="SC" <%= filters.category === 'SC' ? 'selected' : '' %>>Scheduled Caste (SC)</option>
              <option value="Minority" <%= filters.category === 'Minority' ? 'selected' : '' %>>Minority</option>
            </select>
          </div>

          <!-- Income Limit -->
          <div class="form-group">
            <label for="max_income" class="form-label"><%= (lang === 'hi') ? 'पारिवारिक आय' : 'Annual Income' %></label>
            <select id="max_income" name="max_income" class="form-select">
              <option value="">Any Income Limit</option>
              <option value="200000" <%= filters.max_income === '200000' ? 'selected' : '' %>>Up to ₹2,00,000</option>
              <option value="250000" <%= filters.max_income === '250000' ? 'selected' : '' %>>Up to ₹2,50,000</option>
              <option value="350000" <%= filters.max_income === '350000' ? 'selected' : '' %>>Up to ₹3,50,000</option>
            </select>
          </div>

          <div style="display: flex; gap: 0.5rem; margin-top: 1.25rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">
              <%= (lang === 'hi') ? 'लागू करें' : 'Apply Filters' %>
            </button>
            <a href="/scholarships" class="btn btn-secondary">
              Reset
            </a>
          </div>
        </form>
      </aside>

      <!-- Right Side: Scholarship Cards List -->
      <div class="scholarship-results-wrap">
        <div style="font-weight: 700; color: var(--text-main); margin-bottom: 1rem; font-size: 0.95rem;">
          <%= scholarships.length %> <%= (lang === 'hi') ? 'छात्रवृत्तियां मिलीं' : 'scholarships found' %>
        </div>

        <% if (scholarships.length === 0) { %>
          <div class="card" style="text-align: center; padding: 2.5rem 1rem;">
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">🔍</div>
            <h3 style="font-weight: 700; margin-bottom: 0.25rem;"><%= (lang === 'hi') ? 'कोई परिणाम नहीं मिला' : 'No Scholarships Found' %></h3>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">
              <%= (lang === 'hi') ? 'कृपया फ़िल्टर को सामान्य बनाकर पुनः प्रयास करें।' : 'Try loosening the income or category filters.' %>
            </p>
            <a href="/scholarships" class="btn btn-sm btn-primary"><%= (lang === 'hi') ? 'सभी देखें' : 'View All' %></a>
          </div>
        <% } else { %>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% scholarships.forEach(s => { %>
              <article class="card scholarship-clean-card">
                <div class="scholarship-card-main">
                  <div>
                    <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.4rem;">
                      <span class="badge badge-primary"><%= s.education_level %></span>
                      <span class="badge badge-warning"><%= s.category %></span>
                      <span class="badge badge-slate"><%= s.state %></span>
                    </div>

                    <h3 class="scholarship-card-heading">
                      <%= (lang === 'hi') ? s.name_hi : s.name %>
                    </h3>

                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                      🏛️ <%= s.provider %>
                    </div>

                    <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 0.75rem;">
                      <%= (lang === 'hi') ? s.description_hi : s.description %>
                    </p>
                  </div>

                  <div class="scholarship-amount-block">
                    <strong class="scholarship-amount-val"><%= s.benefit_amount %></strong>
                    <span class="scholarship-deadline-tag">⏳ Deadline: <%= s.deadline %></span>
                  </div>
                </div>

                <!-- Eligibility Row -->
                <div class="scholarship-eligibility-row">
                  <div><strong>Income:</strong> Up to ₹<%= s.max_income.toLocaleString('en-IN') %>/yr</div>
                  <div>•</div>
                  <div><strong>Min Marks:</strong> <%= s.min_percentage %>%</div>
                  <div>•</div>
                  <div><strong>Gender:</strong> <%= s.gender %></div>
                </div>

                <!-- Footer with View Details -->
                <div class="scholarship-card-action-bar">
                  <span style="font-size: 0.75rem; color: var(--text-muted);">National Portal Verified</span>
                  <a href="<%= s.official_portal %>" target="_blank" rel="noopener" class="btn btn-sm btn-primary">
                    <span><%= (lang === 'hi') ? 'विवरण देखें' : 'View Details' %></span>
                    <span>↗</span>
                  </a>
                </div>
              </article>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<script>
  document.getElementById('fill-demo-profile').addEventListener('click', () => {
    document.getElementById('state').value = 'Jharkhand';
    document.getElementById('category').value = 'ST';
    document.getElementById('max_income').value = '250000';
    document.getElementById('education_level').value = 'Class 9-10';
    if (window.showToast) {
      window.showToast('Demo profile applied: Class 10, ST, Jharkhand', 'info');
    }
    setTimeout(() => {
      document.getElementById('scholarship-filter-form').submit();
    }, 350);
  });
</script>

<%- include('partials/bottom-nav', { activeTab: 'scholarships' }) %>
<%- include('partials/footer') %>
