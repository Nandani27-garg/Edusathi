<%- include('partials/header', { pageTitle: (lang === 'hi') ? course.title_hi : course.title }) %>
<%- include('partials/navbar', { activeTab: 'learn' }) %>

<div class="app-layout">
  <%- include('partials/sidebar', { activeTab: 'learn' }) %>

  <main class="app-content">
    <div style="margin-bottom: 1.25rem;">
      <a href="/learn" style="font-size: 0.9rem; font-weight: 600; color: var(--primary); display: inline-flex; align-items: center; gap: 0.35rem;">
        ← <%= (lang === 'hi') ? 'सभी विषयों पर वापस जाएं' : 'Back to all courses' %>
      </a>
    </div>

    <!-- Course Hero Banner -->
    <div class="card" style="background: linear-gradient(135deg, <%= course.color %> 0%, #1E3A8A 100%); color: white; margin-bottom: 2rem; padding: 2rem;">
      <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
        <span class="badge" style="background: rgba(255,255,255,0.2); color: white;"><%= course.education_level %></span>
        <span class="badge" style="background: rgba(255,255,255,0.2); color: white;"><%= course.category %></span>
        <span class="badge badge-success">✓ <%= (lang === 'hi') ? 'ऑफ़लाइन अध्ययन उपलब्ध' : 'Offline Learning Available' %></span>
      </div>
      <h1 style="font-size: 1.85rem; font-weight: 800; margin-bottom: 0.5rem; color: white;">
        <%= (lang === 'hi') ? course.title_hi : course.title %>
      </h1>
      <p style="font-size: 1rem; opacity: 0.92; max-width: 800px; line-height: 1.5; margin: 0;">
        <%= (lang === 'hi') ? course.description_hi : course.description %>
      </p>
    </div>

    <!-- Lessons List -->
    <div class="section-label-small" style="margin-bottom: 1rem;">
      <span>📖</span>
      <span><%= (lang === 'hi') ? 'पाठ्यक्रम पाठ सूची' : 'COURSE LESSONS' %></span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.85rem;">
      <% lessons.forEach(lesson => { %>
        <% 
          const isDone = userProgress && userProgress[lesson.id] && userProgress[lesson.id].completed;
        %>
        <div class="card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding: 1.15rem 1.25rem;">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="width: 2.25rem; height: 2.25rem; border-radius: 50%; background: <%= isDone ? '#D1FAE5' : '#EFF6FF' %>; color: <%= isDone ? '#065F46' : 'var(--primary)' %>; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.95rem; flex-shrink: 0;">
              <%= isDone ? '✓' : lesson.order_index %>
            </div>
            <div>
              <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.2rem; color: var(--text-main);">
                <%= (lang === 'hi') ? lesson.title_hi : lesson.title %>
              </h3>
              <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.4; max-width: 650px; margin: 0;">
                <%= (lang === 'hi') ? lesson.summary_hi : lesson.summary %>
              </p>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <% if (isDone) { %>
              <span class="badge badge-success"><%= (lang === 'hi') ? 'पूर्ण' : 'Completed' %></span>
            <% } %>
            <a href="/learn/lesson/<%= lesson.id %>" class="btn btn-sm btn-primary">
              <%= (lang === 'hi') ? 'पाठ पढ़ें →' : 'Study Lesson →' %>
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  </main>
</div>

<%- include('partials/bottom-nav', { activeTab: 'learn' }) %>
<%- include('partials/footer') %>
