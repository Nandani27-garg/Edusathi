<!-- Toast Notifications Container -->
<div id="toast-container" class="toast-container" aria-live="polite"></div>

<!-- Client Scripts -->
<script src="/js/main.js"></script>
<script src="/js/offline-storage.js"></script>

<!-- Service Worker Registration for Offline First PWA -->
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/service-worker.js')
        .then(reg => {
          console.log('EduSaarthi PWA ServiceWorker registered with scope:', reg.scope);
        })
        .catch(err => {
          console.log('ServiceWorker registration skipped or failed:', err);
        });
    });
  }
</script>
